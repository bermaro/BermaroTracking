{# BERMARO Tracking: Bestelldaten (nur auf der Bestellbestätigung gefüllt) und Haupt-Skript #}
<script>
    window.BermaroTrackingOrder = {{ orderJson | raw }};
    {# Das Haupt-Skript wird per Inline-Lader UNABHÄNGIG (async) eingebunden.
       Grund (Test 22.10.2026, lackier-bedarf.info): Ein normaler Skript-Tag wartete hinter
       langsamen Fremd-Skripten und startete teils erst nach über 10 Sekunden oder gar nicht.
       Sicherheitsnetz: Ist das Skript nach dem Seitenaufbau noch nicht gestartet, wird es
       nachgeladen. Das Skript selbst verhindert eine doppelte Ausführung (BermaroTrackingStarted). #}
    (function (window, document) {
        if (window.BermaroTrackingLoaderStarted) {
            return;
        }
        window.BermaroTrackingLoaderStarted = true;
        var src = {{ (plugin_path('BermaroTracking') ~ '/js/bermaro-tracking.js?v=' ~ version) | json_encode | raw }};
        var attempts = 0;

        function load() {
            if (window.BermaroTrackingStarted || attempts >= 4) {
                return;
            }
            attempts++;
            var script = document.createElement("script");
            script.src = attempts === 1 ? src : src + "&retry=" + attempts;
            script.async = true;
            (document.head || document.body || document.documentElement).appendChild(script);
        }

        function retry(delay) {
            window.setTimeout(load, delay);
        }

        load();
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", function () {
                retry(2500);
            });
        } else {
            retry(2500);
        }
        if (document.readyState === "complete") {
            retry(1000);
        } else {
            window.addEventListener("load", function () {
                retry(1000);
            });
        }
    })(window, document);
</script>
