{# BERMARO Tracking: Tag Manager im <head> laden

   WICHTIG (seit Version 1.0.18, Befund vom 27.10.2026):
   plentyShop LTS (Ceres) sammelt alle <script>-Tags aus normalen Layout-Containern ein und
   setzt sie ganz ans Ende der Seite (Ceres\Extensions\TwigStyleScriptTagFilter, Suchmuster
   "<script[^2]*>"). Dadurch lud der Tag Manager erst nach dem kompletten Seitenaufbau und
   Google Ads meldete "Tag nicht richtig platziert – zu weit unten auf der Seite".
   Script-Tags, deren Start-Tag die Ziffer 2 enthält, lässt dieser Filter bewusst in Ruhe.
   Deshalb tragen beide Script-Tags hier das Merkmal data-bermaro-head="v2" – so bleiben sie
   im <head>. Bitte dieses Merkmal NICHT entfernen. #}
<script data-bermaro-head="v2">
    window.dataLayer = window.dataLayer || [];
    window.BermaroTrackingConfig = {{ configJson | raw }};
</script>
<script data-bermaro-head="v2">
    (function (window, document) {
        "use strict";

        var cfg = window.BermaroTrackingConfig;
        if (!cfg || !cfg.active || !cfg.containerId || window.BermaroTrackingHeadStarted) {
            return;
        }
        window.BermaroTrackingHeadStarted = true;

        /*
         * Als ERSTES beim Ereignis "Seite fertig geladen" anmelden – noch bevor der Tag Manager
         * geladen wird. Dadurch läuft dieser Aufruf vor dem Tag-Manager-Ereignis gtm.load, und das
         * Haupt-Skript kann ausstehende Seitendaten (globalValues, Artikelansicht) rechtzeitig senden
         * (Remarketing-Tag auf pelletgrill.rocks/B2B feuert bei gtm.load).
         */
        window.addEventListener("load", function () {
            try {
                if (typeof window.BermaroTrackingBeforeLoad === "function") {
                    window.BermaroTrackingBeforeLoad();
                }
            } catch (error) {
                // Fehler dürfen den Shop nie stören
            }
        });

        var dataLayer = window.dataLayer;
        var useConsentMode = cfg.consentMode === "basic" || cfg.consentMode === "advanced";
        var lastConsentState = "";
        var lastConsentSnapshot = null;
        var gtmLoaded = false;

        /* gtag-Hilfsfunktion (schreibt nur in den dataLayer, lädt nichts nach) */
        function gtag() {
            dataLayer.push(arguments);
        }

        /* Ist derselbe Tag-Manager-Container schon von einem anderen Plugin eingebunden?
           (z. B. weil das alte Plugin noch aktiv ist) – dann NICHT ein zweites Mal laden. */
        function containerAlreadyPresent() {
            if (window.google_tag_manager && window.google_tag_manager[cfg.containerId]) {
                return true;
            }
            var scripts = document.getElementsByTagName("script");
            for (var i = 0; i < scripts.length; i++) {
                var src = scripts[i].src || "";
                if (src.indexOf("googletagmanager.com/gtm.js") !== -1 && src.indexOf(cfg.containerId) !== -1) {
                    return true;
                }
            }
            return false;
        }

        /*
         * Einwilligung direkt aus dem plentyShop-Cookie "plenty-shop-cookie" lesen.
         * Grund: Im <head> gibt es den ConsentManager von plentyShop noch nicht (er wird erst am
         * Seitenende geladen). Das Cookie ist aber sofort lesbar. Inhalt (URL-kodiert), z. B.:
         * {"necessary":{...},"tracking":{"googleanalytics":true},"marketing":{"googleads":true},"_id":"..."}
         * Ergebnis: das gelesene Objekt oder null (kein Cookie = Besucher hat noch nicht geantwortet).
         */
        function readConsentCookie() {
            try {
                var parts = document.cookie ? document.cookie.split(";") : [];
                for (var i = 0; i < parts.length; i++) {
                    var part = parts[i].replace(/^\s+/, "");
                    if (part.indexOf("plenty-shop-cookie=") !== 0) {
                        continue;
                    }
                    var raw = part.substring("plenty-shop-cookie=".length);
                    var data = null;
                    // Einmal (oder sicherheitshalber zweimal) dekodieren, dann als JSON lesen
                    for (var round = 0; round < 2 && data === null; round++) {
                        raw = decodeURIComponent(raw);
                        try {
                            data = JSON.parse(raw);
                        } catch (parseError) {
                            data = null;
                        }
                    }
                    return data && typeof data === "object" ? data : null;
                }
            } catch (error) {
                // Cookie nicht lesbar – dann eben ohne
            }
            return null;
        }

        /* Ist ein Schlüssel "gruppe.dienst" laut Cookie erlaubt? */
        function isConsentedByCookie(key) {
            var data = readConsentCookie();
            if (!data || !key) {
                return false;
            }
            var dot = key.indexOf(".");
            if (dot < 1) {
                return false;
            }
            var group = data[key.substring(0, dot)];
            return !!(group && typeof group === "object" && group[key.substring(dot + 1)] === true);
        }

        /* Ist der ConsentManager von plentyShop schon da und hat der Besucher geantwortet? */
        function consentManagerReady() {
            var cm = window.ConsentManager;
            return !!(cm && typeof cm.hasResponse === "function" && typeof cm.isConsented === "function" && cm.hasResponse());
        }

        /* Hilfe: Ist ein Consent-Schlüssel erlaubt?
           Vorrang hat der ConsentManager; solange er noch nicht geladen ist, gilt das Cookie. */
        function isConsented(key) {
            if (!key) {
                return false;
            }
            var cm = window.ConsentManager;
            if (cm && typeof cm.isConsented === "function" && (typeof cm.hasResponse !== "function" || cm.hasResponse())) {
                return !!cm.isConsented(key);
            }
            return isConsentedByCookie(key);
        }

        /* Aktuellen Einwilligungsstand lesen (ConsentManager oder – im <head> – das Cookie) */
        function readConsentState() {
            if (!consentManagerReady() && readConsentCookie() === null) {
                return null;
            }
            var analytics = isConsented(cfg.consentKeys.analytics);
            var ads = isConsented(cfg.consentKeys.ads);
            return {
                analytics_storage: analytics ? "granted" : "denied",
                ad_storage: ads ? "granted" : "denied",
                ad_user_data: ads ? "granted" : "denied",
                ad_personalization: ads ? "granted" : "denied"
            };
        }

        /* Einwilligungen als Text (zum Erkennen echter Änderungen) */
        function consentSnapshot() {
            var cm = window.ConsentManager;
            if (!cm || typeof cm.getConsents !== "function") {
                return null;
            }
            try {
                return JSON.stringify(cm.getConsents() || {});
            } catch (error) {
                return null;
            }
        }

        /* Das zuletzt von UNS gesendete consent-update (um fremde Updates zu erkennen) */
        var ownConsentEntry = null;
        var pushingOwnConsent = false;

        /* Consent Mode: Einwilligung an Google melden (nur wenn eingeschaltet).
           force = true: auch senden, wenn sich unser Stand nicht geändert hat
           (nötig, wenn ein anderes Skript – z. B. Shoplytics – danach "denied" gesendet hat). */
        function updateConsent(force) {
            if (!useConsentMode) {
                return;
            }
            var state = readConsentState();
            if (!state) {
                return;
            }
            var key = JSON.stringify(state);
            if (key === lastConsentState && force !== true) {
                return;
            }
            lastConsentState = key;
            pushingOwnConsent = true;
            try {
                gtag("consent", "update", state);
                ownConsentEntry = dataLayer[dataLayer.length - 1];
            } finally {
                pushingOwnConsent = false;
            }
        }

        /* Ist dieser dataLayer-Eintrag ein consent-update? */
        function isConsentUpdate(entry) {
            return !!(entry && typeof entry === "object" && typeof entry.length === "number" &&
                entry[0] === "consent" && entry[1] === "update");
        }

        /*
         * Fremde consent-updates überstimmen (Stand 22.10.2026):
         * Shoplytics sendet auf lackier-bedarf.info "consent update: denied", weil es die
         * plentyShop-Einwilligung nicht erkennt (das Cookie ist URL-kodiert gespeichert).
         * Ohne Korrektur gingen Käufe und Ads-Conversions "ohne Cookies" (gcs=G100) raus,
         * obwohl der Besucher im Cookie-Banner zugestimmt hat. Wir melden deshalb direkt danach
         * den ECHTEN Stand aus dem plentyShop-Cookie-Banner erneut (granted ODER denied).
         */
        function reassertConsentIfForeign() {
            if (!useConsentMode) {
                return;
            }
            for (var i = dataLayer.length - 1; i >= 0; i--) {
                if (isConsentUpdate(dataLayer[i])) {
                    if (dataLayer[i] !== ownConsentEntry) {
                        updateConsent(true);
                    }
                    return;
                }
            }
        }

        /* dataLayer.push "umwickeln": sobald ein anderes Skript ein consent-update sendet,
           sofort den echten Stand hinterher schicken (vor allen folgenden Ereignissen). */
        if (useConsentMode && typeof dataLayer.push === "function") {
            var originalPush = dataLayer.push;
            dataLayer.push = function () {
                var result = originalPush.apply(dataLayer, arguments);
                if (!pushingOwnConsent) {
                    for (var a = 0; a < arguments.length; a++) {
                        if (isConsentUpdate(arguments[a])) {
                            updateConsent(true);
                            break;
                        }
                    }
                }
                return result;
            };
        }

        /* Den Tag Manager selbst laden (nur einmal) */
        function loadGtm() {
            if (gtmLoaded) {
                return;
            }
            gtmLoaded = true;
            if (containerAlreadyPresent()) {
                if (window.console && window.console.warn) {
                    window.console.warn("[BermaroTracking] Container " + cfg.containerId + " ist schon eingebunden (altes Plugin noch aktiv?) – wird nicht doppelt geladen.");
                }
                return;
            }
            updateConsent();
            dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var script = document.createElement("script");
            script.async = true;
            script.src = "https://www.googletagmanager.com/gtm.js?id=" + encodeURIComponent(cfg.containerId);
            var first = document.getElementsByTagName("script")[0];
            first.parentNode.insertBefore(script, first);
        }

        /* Darf der Tag Manager laden? (bei Einwilligungspflicht: sobald IRGENDEIN Dienst erlaubt ist) */
        function mayLoadGtm() {
            var needsConsent = cfg.consentMode === "basic" || cfg.loadGtmOnlyAfterConsent;
            if (!needsConsent) {
                return true;
            }
            return isConsented(cfg.consentKeys.analytics) || isConsented(cfg.consentKeys.ads) || isConsented(cfg.consentKeys.bing);
        }

        function tryLoadGtm() {
            if (mayLoadGtm()) {
                loadGtm();
            }
        }

        /*
         * Felix-Format: Cookie "consentActiveStatus" setzen – GENAU wie das alte Felix-Ries-Plugin.
         * Der Tag-Manager-Container von lackier-bedarf.info (GTM-PKMRNKBW) liest dieses Cookie in
         * einer Variable und prüft damit bei 13 Auslösern (u. a. Google-Ads-Conversion), ob der
         * Besucher eingewilligt hat. Fehlt das Cookie, feuern diese Tags NICHT.
         * Inhalt: [{"dienst":"true"|"false", ...}] – "true" = Dienst braucht eine Einwilligung
         * (ist im Cookie-Banner registriert). Ob tatsächlich eingewilligt wurde, entnimmt der
         * Container dem plentyShop-Cookie-Banner-Cookie. (Festgestellt am 22.10.2026.)
         */
        if ((cfg.formats || []).indexOf("felixries") !== -1) {
            try {
                var felixKeys = ["googleanalytics", "googleads", "facebookpixel", "bingads", "pinterest", "adcell",
                    "econda", "channelpilot", "sendinblue", "hotjar", "moebelde", "intelligentreach", "clarity", "awin", "belboon"];
                var status = {};
                var activeKeys = cfg.activeConsentKeys || [];
                var i;
                for (i = 0; i < felixKeys.length; i++) {
                    status[felixKeys[i]] = activeKeys.indexOf(felixKeys[i]) !== -1 ? "true" : "false";
                }
                for (i = 0; i < activeKeys.length; i++) {
                    status[activeKeys[i]] = "true";
                }
                document.cookie = "consentActiveStatus=" + JSON.stringify([status]) +
                    "; path=/; max-age=31536000; SameSite=Lax" +
                    (window.location.protocol === "https:" ? "; Secure" : "");
            } catch (error) {
                // Cookie konnte nicht gesetzt werden – Shop läuft trotzdem weiter
            }
        }

        /* Standard-Einwilligung: alles abgelehnt, bis der Besucher zustimmt */
        if (useConsentMode) {
            gtag("consent", "default", {
                ad_storage: "denied",
                analytics_storage: "denied",
                ad_user_data: "denied",
                ad_personalization: "denied",
                wait_for_update: 500
            });
            updateConsent();
        }

        /* Für das Haupt-Skript bereitstellen */
        window.BermaroTrackingUpdateConsent = updateConsent;
        window.BermaroTrackingLoadGtm = tryLoadGtm;

        /* Änderungen im Cookie-Banner (mehrere Meldungen kurz hintereinander werden zusammengefasst).
           "consentChanged" wird nur gesendet, wenn sich die Auswahl wirklich geändert hat. */
        var consentTimer = null;
        document.addEventListener("consent-change", function () {
            if (consentTimer) {
                window.clearTimeout(consentTimer);
            }
            consentTimer = window.setTimeout(function () {
                consentTimer = null;
                updateConsent();
                tryLoadGtm();
                var snapshot = consentSnapshot();
                if (snapshot !== null && snapshot === lastConsentSnapshot) {
                    return;
                }
                lastConsentSnapshot = snapshot;
                if (cfg.pushConsentChanged) {
                    dataLayer.push({ event: "consentChanged" });
                }
            }, 300);
        });

        document.addEventListener("DOMContentLoaded", function () {
            // Stand beim Laden merken, damit ein Speichern ohne Änderung kein "consentChanged" auslöst
            if (lastConsentSnapshot === null) {
                lastConsentSnapshot = consentSnapshot();
            }
            updateConsent();
            reassertConsentIfForeign();
            tryLoadGtm();
        });

        /* Sicherheitsnetz, falls ein anderes Skript dataLayer.push ersetzt hat:
           in den ersten 20 Sekunden regelmäßig prüfen, ob das letzte consent-update von uns stammt. */
        if (useConsentMode) {
            var checks = 0;
            var checkTimer = window.setInterval(function () {
                checks++;
                reassertConsentIfForeign();
                if (checks >= 40) {
                    window.clearInterval(checkTimer);
                }
            }, 500);
            window.addEventListener("load", reassertConsentIfForeign);
        }

        tryLoadGtm();
    })(window, document);
</script>
